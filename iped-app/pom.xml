    <build>
        <plugins>
            <!-- Must be declared before the download plugin, both run in the package phase. The JRE zip is
                 unpacked at every execution of the download plugin, so it is skipped if the release already
                 has the JRE of the configured version. An outdated JRE folder is removed first, to not leave
                 files of the previous version behind. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-jre</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <exportAntProperties>true</exportAntProperties>
                            <target>
                                <!-- ${release.dir} refers to the parent project, which is not resolved here -->
                                <property name="bundled.jre.dir" location="${project.build.directory}/../../target/release/iped-${project.version}/jre" />
                                <loadfile property="bundled.jre.current" srcFile="${bundled.jre.dir}/release" failonerror="false" quiet="true" />
                                <condition property="bundled.jre.skip" value="true" else="false">
                                    <matches string="${bundled.jre.current}" pattern="JAVA_RUNTIME_VERSION=&quot;\Q${bundled.jre.release}\E[-&quot;]" />
                                </condition>
                                <!-- a folder that does not exist if the JRE is up to date -->
                                <condition property="bundled.jre.outdated.dir" value="${bundled.jre.dir}-none" else="${bundled.jre.dir}">
                                    <istrue value="${bundled.jre.skip}" />
                                </condition>
                                <delete dir="${bundled.jre.outdated.dir}" />
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- the executions of the external tools the parsers use are defined once, in the
                 pluginManagement of the parent pom: iped-parsers-impl unpacks them for its tests too -->
            <plugin>
                <groupId>io.github.download-maven-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- the zip is kept in the cache of this plugin in the local maven repository -->
                        <id>download-jre</id>
                        <phase>package</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <!-- set by the check-jre execution above -->
                            <skip>${bundled.jre.skip}</skip>
                            <url>https://github.com/bell-sw/Liberica/releases/download/${bundled.jre.release}/bellsoft-jre${bundled.jre.release}-windows-amd64-full.zip</url>
                            <sha256>${bundled.jre.sha256}</sha256>
                            <unpack>true</unpack>
                            <!-- the root folder of the zip is named after its version -->
                            <fileMappers>
                                <org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
                                    <pattern>^jre-[^/]+/</pattern>
                                    <replacement>jre/</replacement>
                                </org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
                            </fileMappers>
                            <outputDirectory>${release.dir}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
