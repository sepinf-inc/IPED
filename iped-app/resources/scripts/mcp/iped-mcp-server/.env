# IPED MCP Server Configuration

# Path to IPED installation folder (contains lib/, iped-engine*.jar, etc.)
IPED_HOME=C:\iped\IPED\target\release\iped-4.4.0-SNAPSHOT

# Path to processed case folder (or .txt file listing multiple cases)
CASE_PATH=C:\iped\output\output002_859fc10df

# Optional: Custom JAVA_HOME (defaults to JAVA_HOME env var)
JAVA_HOME=C:\Program Files\BellSoft\LibericaJDK-11-Full\

# JVM maximum heap size
JVM_MAX_HEAP=4g

# Host and port for MCP server (SSE transport, optional)
MCP_HOST=127.0.0.1
MCP_PORT=8100
